    {
      "name": "2. Trang HTML",
      "description": "Render bằng Chrome headless, lưu MinIO, đọc lại qua content_ref.",
      "item": [
        {
          "name": "Gửi trang HTML",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const j = pm.response.json();",
                  "pm.test('Có job_id', () => pm.expect(j.job_id).to.be.a('string'));",
                  "pm.collectionVariables.set('job_html', j.job_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/load",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url_html}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Chờ trang HTML",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1500); // chờ 1,5 s trước mỗi lần hỏi"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const counter = 'poll_' + pm.info.requestName;",
                  "if (['queued', 'downloading', 'storing'].includes(j.status)) {",
                  "  const n = Number(pm.collectionVariables.get(counter) || 0) + 1;",
                  "  pm.collectionVariables.set(counter, n);",
                  "  pm.test('Job chưa xong (status=' + j.status + '). Bấm Send lại, Runner sẽ tự hỏi lại', () => true);",
                  "  if (n < 40) postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset(counter);",
                  "  pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "  pm.test('status = done', () => pm.expect(j.status).to.eql('done'));",
                  "  pm.test('format = html', () => pm.expect(j.format).to.eql('html'));",
                  "  pm.test('Có content_ref', () => pm.expect(j.content_ref).to.be.a('string'));",
                  "  pm.collectionVariables.set('ref_html', j.content_ref);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/jobs/{{job_html}}"
          }
        },
        {
          "name": "Đọc nội dung HTML qua content_ref",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Là HTML', () => pm.expect(pm.response.text().toLowerCase()).to.include('<html'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ref_html}}"
          }
        }
      ]
    },
