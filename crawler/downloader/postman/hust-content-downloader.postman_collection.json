              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status hợp lệ', () => pm.expect(pm.response.json().status).to.be.oneOf(['đang chờ', 'đang tải', 'đang bận']));"
