# API
PORT=8800
NODE_ENV=development

# MinIO/S3 — chỉ dùng giá trị mặc định cho môi trường local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hust-raw
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=900

# Giới hạn tải
MAX_FILE_BYTES=20971520
MAX_HTML_BYTES=5242880
MAX_CONCURRENT=2
QUEUE_SIZE=20
# auto: bỏ HEAD cho URL có đuôi tài liệu; always: HEAD mọi URL; never: không HEAD
PROBE_MODE=auto
PROBE_TIMEOUT_MS=15000
HTML_TIMEOUT_MS=30000
FILE_TIMEOUT_MS=60000

# Retry và lịch sự với nguồn
RETRY_COUNT=3
RETRY_BASE_MS=500
RETRY_MAX_MS=8000
RETRY_JITTER_MS=250
HOST_DELAY_MS=500
RESPECT_ROBOTS=false
ALLOWED_DOMAINS=
# Các segment path được coi là trang đăng nhập khi phát hiện auth_required
AUTH_LOGIN_PATH_SEGMENTS=login,signin,sign-in,dang-nhap,dangnhap,sso,oauth

# Trình duyệt và log
CHROME_BIN=/usr/bin/chromium
# Bỏ ảnh/media/font để giảm băng thông; đặt rỗng nếu cần tải đầy đủ tài nguyên
BLOCK_RESOURCE_TYPES=image,media,font
LOG_LEVEL=info
USER_AGENT=HUST-Content-Downloader/1.0
JOB_TTL_MS=3600000
MAX_JOBS=1000

# Module đọc nội dung: POST /parse sau mỗi job done. Để trống = không chuyển
READER_URL=
READER_TIMEOUT_MS=30000
READER_RETRY_COUNT=3
