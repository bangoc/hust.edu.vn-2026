{
  "name": "hust-content-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Dịch vụ tải nội dung (HTML, PDF, DOCX, ...) và lưu trữ object cho pipeline tìm kiếm HUST",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node index.js",
    "mock:api": "node mock/mock-api-server.js",
    "check": "node --check index.js && find . -path ./node_modules -prune -o -name '*.js' -print | xargs -n 1 node --check",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:s3": "node --test test/s3/*.test.js",
    "test:all": "npm test && npm run test:s3",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/unit/*.test.js test/integration/*.test.js",
    "test:smoke": "SMOKE=1 node --test test/smoke/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "express": "^4.21.2",
    "puppeteer-core": "^25.16.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  }
}
